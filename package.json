{
  "name": "zen-reader-monorepo",
  "private": true,
  "workspaces": [
    "app",
    "web"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=web",
    "dev:app": "npm run dev --workspace=app",
    "dev:web": "npm run dev --workspace=web",
    "build": "npm run build --workspace=app && npm run build --workspace=web",
    "build:app": "npm run build --workspace=app",
    "build:firefox": "npm run build:firefox --workspace=app",
    "build:web": "npm run build --workspace=web",
    "arch": "npm run arch --workspace=app"
  }
}
